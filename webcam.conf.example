# omarchy-privacy webcam override — copy to ~/.config/omarchy-privacy/webcam.conf
#
# By default the plugin auto-detects the first USB device that exposes a UVC
# video interface. Set either value below to override, then re-run
#   sudo ~/.config/omarchy/plugins/io.github.grootaiinfinity.privacy/setup_udev.sh

# Pin a specific camera by USB vendor:product id (see `lsusb`).
#WEBCAM_USB_ID=13d3:56a2

# Group granted write access to the device's `authorized` attribute.
#WEBCAM_GROUP=wheel
